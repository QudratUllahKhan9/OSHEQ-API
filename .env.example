PORT=5000
# Frontend origin(s) allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,https://osheq-deshborad-frontend.vercel.app
# Public URL of THIS backend (used inside QR codes). Empty = derive from request.
BACKEND_BASE_URL=
# Admin dashboard key (change this!)
ADMIN_KEY=osheq-admin-2026
JWT_SECRET=change-me-to-a-long-random-string
# Optional: MongoDB Atlas. If unreachable/unset the API falls back to data/db.json
MONGO_URI=
# SMTP for ATP credential emails (leave empty to write data/mail-outbox.json instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OSHEQ Certification <no-reply@osheq.us>"
